#!/bin/bash
set -euo pipefail
source "$(dirname "$0")/common.sh"

require cpio
require gzip
require_initramfs
mkdir -p "$ISO_ROOT/boot"
log "building initramfs"
rm -f "$LIVE_BUILD/initramfs-live.img"
(
    cd "$INITRAMFS_TREE"
    find . -print0 | cpio --null -o -H newc 2>/dev/null | gzip -9
) > "$LIVE_BUILD/initramfs-live.img"
cp "$LIVE_BUILD/initramfs-live.img" "$ISO_ROOT/boot/initramfs-live.img"
log "initramfs copied to $ISO_ROOT/boot/initramfs-live.img"
