#!/bin/bash
set -euo pipefail
source "$(dirname "$0")/common.sh"

require qemu-system-x86_64
[ -f "$ISO_IMAGE" ] || die "ISO missing: $ISO_IMAGE"
log "testing ISO with QEMU"
exec qemu-system-x86_64 \
    -machine q35 \
    -m "${QEMU_MEMORY:-2G}" \
    -smp "${QEMU_SMP:-2}" \
    -cdrom "$ISO_IMAGE" \
    -serial stdio \
    -display none \
    -no-reboot
