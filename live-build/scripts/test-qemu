#!/bin/bash
set -euo pipefail
source "$(dirname "$0")/common.sh"

require qemu-system-x86_64
[ -f "$ISO_IMAGE" ] || die "ISO missing: $ISO_IMAGE"
log "testing ISO with QEMU"
accel=()
if [ -r /dev/kvm ] && [ -w /dev/kvm ]; then
    accel=(-enable-kvm -cpu host)
    log "using KVM"
else
    log "KVM unavailable; TCG will look stuck during early boot"
fi
exec qemu-system-x86_64 \
    "${accel[@]}" \
    -machine q35 \
    -m "${QEMU_MEMORY:-2G}" \
    -smp "${QEMU_SMP:-2}" \
    -cdrom "$ISO_IMAGE" \
    -device virtio-keyboard-pci \
    -device virtio-tablet-pci \
    -serial mon:stdio \
    -display gtk \
    -vga std \
    -no-reboot
